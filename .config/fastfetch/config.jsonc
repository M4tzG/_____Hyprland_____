{
    "logo": {
        "type": "kitty-direct",
        "source": "~/.config/hypr/themes/_default/assets/fastfetch_art.png",
        "width": 50,
        "padding": {
            "top": 2,
            "right": 1,
            "bottom": 0,
            "left": 2
        }
    },
    "display": {
        "separator": "  "
    },
    "modules": [
        {
            "type": "title",
            "key": "          "
        },
        {
            "type": "DateTime",
            "key": "         "
        },
        {
            "type": "custom",
            "format": "《·───────────────·》◈《·──────────────·》"
        },

        {
            "type": "os",
            "key": "    OS",
            "keyColor": "#F78DBD"
        },
        {
            "type": "kernel",
            "key": "    Kernel",
            "keyColor": "#F78DBD"
        },
        {
            "type": "packages",
            "key": "    Packages",
            "keyColor": "#F78DBD"
        },

        "break",

        {
            "type": "wm",
            "key": "    WM",
            "keyColor": "#8C85B7"
        },
        {
            "type": "terminal",
            "key": "    Terminal",
            "keyColor": "#8C85B7"
        },
        {
            "type": "shell",
            "key": "    Shell",
            "keyColor": "#8C85B7"
        },

        "break",

        {
            "type": "display",
            "key": "    Display",
            "keyColor": "#A66184"
        },
        {
            "type": "cpu",
            "key": "    CPU",
            "format": "{1}",
            "keyColor": "#A66184"
        },
        {
            "type": "gpu",
            "key": "    GPU",
            "format": "{2}",
            "keyColor": "#A66184"
        },
        {
            "type": "gpu",
            "key": "    GPU Driver",
            "format": "{3}",
            "keyColor": "#A66184"
        },
        {
            "type": "memory",
            "key": "    Memory",
            "keyColor": "#A66184"
        },

        "break",

        {
            "type": "uptime",
            "key": "    Uptime ",
            "keyColor": "#E6C4E6"
        },
        {
            "type": "Battery",
            "key": "    Battery ",
            "keyColor": "#E6C4E6"
        },
        {
            "type": "custom",
            "format": "《·───────────────·》◈《·──────────────·》"
        },

        {
            "type": "colors",
            "paddingLeft": 3,
            "symbol": "circle"
        },
        "break"
    ]
}
